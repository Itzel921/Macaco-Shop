<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Macaco Shop</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Macaco_Shop.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/estilos.css" asp-append-version="true" />
</head>
<body>

    <header>
        <!-- Agregamos shadow-sm y bg-transparent para evitar conflictos de color -->
        <nav class="py-2 shadow-sm" style="background-color: #a3ff99;">
            <div class="container-fluid d-flex justify-content-between align-items-center px-4">

                <!-- izq -->
                <div class="d-flex gap-4 align-items-center">
                    <a asp-area="" asp-controller="Home" asp-action="Ayuda">Ayuda</a>
                    <a asp-area="" asp-controller="Home" asp-action="Contacto">Contacto</a>
                    <a asp-area="" asp-controller="Home" asp-action="Ubicaciones">Ubicaciones</a>
                </div>

                <!-- centro -->
                <div>
                    <a class="navbar-brand m-0" asp-area="" asp-controller="Home" asp-action="Index">
                        MACACO SHOP
                    </a>
                </div>

                <!-- derecha -->
                <div class="d-flex gap-3 align-items-center">
                    <a class="d-flex align-items-center" href="#">
                        <img src="~/img/carrito.png" style="width: 25px" alt="carrito">
                    </a>
                    <a asp-area="" asp-controller="Home" asp-action="Index">USUARIO</a>
                </div>

            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Macaco_Shop - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
